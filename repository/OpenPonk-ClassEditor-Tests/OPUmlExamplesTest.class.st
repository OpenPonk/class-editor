"
I am a unit test class verifying that all predefined UML model examples generated by OPUmlExamples execute successfully without errors.
"
Class {
	#name : 'OPUmlExamplesTest',
	#superclass : 'TestCase',
	#category : 'OpenPonk-ClassEditor-Tests-Examples',
	#package : 'OpenPonk-ClassEditor-Tests',
	#tag : 'Examples'
}

{ #category : 'running' }
OPUmlExamplesTest >> tearDown [

	Smalltalk garbageCollect.
	super tearDown
]

{ #category : 'tests' }
OPUmlExamplesTest >> testAll [

	OPUmlExamples class selectors
		select: [ :each |
		(each beginsWith: 'open') and: [ (each includes: $:) not ] ]
		thenDo: [ :each | self testExample: each ]
]

{ #category : 'tests' }
OPUmlExamplesTest >> testExample: anExampleSelector [

	| window |
	self assert: anExampleSelector isSymbol.
	self assertCollection: OPUmlExamples class selectors includesAll: { anExampleSelector }.
	window := OPUmlExamples perform: anExampleSelector.
	self assert: (window isKindOf: OPWorkbench).
	window delete
]
